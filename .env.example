# Copy to .env.dev (used by `bun run dev`) and .env.prod (used by `bun run build` and `bun run preview`).

# PostgreSQL. Leave unset in dev to use a local PGlite database in .data/.
DATABASE_URL=

# Seals sessions and derives the key that encrypts stored API keys: `openssl rand -base64 32`.
# Changing it logs everyone out and makes stored API keys unreadable.
NUXT_APP_SECRET=

NUXT_PUBLIC_SITE_URL=
NUXT_PUBLIC_SITE_NAME=

# GitHub OAuth app. Callback URL: <site url>/auth/github
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# File storage. Leave all unset in dev to store files in .data/.
# The storage driver is chosen when the app is built, so these must be set at build time.

# If using S3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
# Optional, for S3-compatible stores
S3_ENDPOINT=

# If using Vercel Blob (also needs `bun add @vercel/blob`)
BLOB_READ_WRITE_TOKEN=

# The inference platform (OpenRouter or DeepSeek) and its API key are set in the admin dashboard, not here.
# The first person to sign up becomes the admin.
