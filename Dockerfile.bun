# syntax=docker/dockerfile:1
# Bun installs, builds and runs the server.
#   docker build -f Dockerfile.bun -t model-chat-studio:bun .
#   docker run -p 3000:3000 --env-file .env.prod model-chat-studio:bun
# The build needs no environment and the image holds no secrets: everything is read when the server starts.

FROM oven/bun:1.4.5 AS build
WORKDIR /app
COPY package.json bun.lock ./
# `postinstall` runs `nuxt prepare`, which needs the sources; `nuxt build` prepares anyway.
RUN bun install --frozen-lockfile --ignore-scripts
COPY . .
RUN NITRO_PRESET=bun bunx --bun nuxt build

FROM oven/bun:1.4.5-slim
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
COPY --from=build --chown=bun:bun /app/.output .output
# Files go here when no S3 bucket is configured; mount a volume on it to keep them.
RUN mkdir .data && chown bun:bun .data
USER bun
EXPOSE 3000
CMD ["bun", ".output/server/index.mjs"]
